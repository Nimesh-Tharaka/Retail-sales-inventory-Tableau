      <aliases enabled='yes' />
      <column caption='Revenue' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_0275208020729856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#13;&#10;    [Quantity] * [Selling Price] * (1 - [Discount Rate]),&#13;&#10;    2&#13;&#10;)' />
      </column>
      <column caption='COGS' datatype='integer' default-format='C1033%' name='[Calculation_0275208020840449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Quantity] * [Unit Cost at Sale]' />
      </column>
      <column caption='Gross Profit' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_0275208020922370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0275208020729856] - [Calculation_0275208020840449]' />
      </column>
      <column caption='Gross Margin' datatype='real' default-format='p0.00%' name='[Calculation_0275208021012483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_0275208020729856]) &lt;&gt; 0 THEN&#13;&#10;    SUM([Calculation_0275208020922370]) / SUM([Calculation_0275208020729856])&#13;&#10;END' />
      </column>
      <column caption='Orders' datatype='integer' default-format='N' name='[Calculation_0275208021073924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Invoice ID])' />
      </column>
      <column caption='Average Order Value' datatype='real' default-format='C1033%' name='[Calculation_0275208021147653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([Invoice ID]) &gt; 0 THEN&#13;&#10;    SUM([Calculation_0275208020729856]) / COUNTD([Invoice ID])&#13;&#10;END' />
      </column>
