      <aliases enabled='yes' />
      <column caption='Inventory Value' datatype='integer' name='[Calculation_0662785887457280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Closing Stock] * [Unit Cost]' />
      </column>
      <column caption='Stock Status' datatype='string' name='[Calculation_0662785889320962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Closing Stock] = 0 THEN&#13;&#10;    &quot;Out of stock&quot;&#13;&#10;ELSEIF [Closing Stock] &lt;= [Reorder Point] THEN&#13;&#10;    &quot;Reorder&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Available&quot;&#13;&#10;END' />
      </column>
      <column caption='Products to Reorder' datatype='integer' name='[Calculation_0662785889415171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Closing Stock] &lt;= [Reorder Point] THEN&#13;&#10;        [Product ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Latest Snapshot' datatype='boolean' name='[Calculation_0662785889460228]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Snapshot Date] = { FIXED : MAX([Snapshot Date]) }' />
      </column>
